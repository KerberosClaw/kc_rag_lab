# LLM Server 設定
# oMLX:  http://127.0.0.1:8000/v1
# Ollama: http://localhost:11434/v1
RAG_LLM_URL=http://127.0.0.1:8000/v1
RAG_LLM_KEY=your-api-key-here

# Embedding Model
# oMLX:  bge-m3-mlx-fp16
# Ollama: nomic-embed-text
RAG_EMBED_MODEL=bge-m3-mlx-fp16

# LLM Model (for answer generation)
# oMLX:  Qwen3-VL-8B-Instruct-MLX-4bit
# Ollama: qwen3-vl:8b-instruct
RAG_LLM_MODEL=Qwen3-VL-8B-Instruct-MLX-4bit
